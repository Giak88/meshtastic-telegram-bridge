# Meshtastic <-> Telegram bridge - configuration
# ./setup.sh writes config.env for you; this file documents every setting.

# Language of logs, menu and messages: en | it
BRIDGE_LANG=en

# Node connection: MESH_PORT for USB (prefer /dev/serial/by-id/..., stable across reconnects),
# or MESH_HOST for a node on Wi-Fi/Ethernet. Both empty = autodetect a USB node.
MESH_PORT=/dev/serial/by-id/usb-XXXX-if00
MESH_HOST=

# Name of the mesh channel bridged with Telegram (case-insensitive, must exist on the node)
MESH_CHANNEL=MyGroup

# Telegram bot token (@BotFather) and group chat id (negative number)
TG_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TG_CHAT_ID=-1001234567890

# Prefix of the repeat command: "!" -> "!repeat 3" / "!ripeti 3"; "BOT" -> "BOT repeat 3"
BRIDGE_PREFIX=!

# Admin node ids (DM commands: status, bridge on|off, ban <id>, unban <id>), comma-separated
BRIDGE_ADMINS=
# 1 = accept admin commands only in PKI-encrypted DMs
BRIDGE_ADMIN_PKI_ONLY=1

# systemd service name
BRIDGE_SERVICE=mesh-telegram-bridge

# Advanced
# Messages kept per side for "repeat" (also the max n)
BRIDGE_HISTORY=20
# Seconds between two "repeat" on the same side
BRIDGE_REPEAT_PAUSE=30
# Max mesh messages for one Telegram message (longer ones are cut with "…"): protects airtime
BRIDGE_MAX_PARTS=4
# Seconds between two mesh transmissions
MESH_TX_INTERVAL=1.5
# Telegram messages older than this (s) are not sent to the mesh (e.g. after downtime)
TG_MAX_AGE=3600
